<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collab_AsIs">
    <bpmn:participant id="Participant_IPS" name="IPS – Asignación de citas médicas (AS-IS)" processRef="Process_AsIs" />
    <bpmn:textAnnotation id="Note_Autorizacion">
      <bpmn:text>Se agendan pacientes inactivos o sin autorización → 10 % de cancelaciones</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Autorizacion" sourceRef="Note_Autorizacion" targetRef="GW_Autorizacion" />
    <bpmn:textAnnotation id="Note_Digitacion">
      <bpmn:text>Doble digitación → errores, citas duplicadas o cruzadas</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Digitacion" sourceRef="Note_Digitacion" targetRef="Task_Registrar" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AsIs">
      <bpmn:lane id="Lane_Sistema" name="Sistema de agendamiento IPS">
        <bpmn:flowNodeRef>Task_GuardarBD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PortalEPS" name="Portal web EPS">
        <bpmn:flowNodeRef>Task_MostrarEstado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auxiliar" name="Auxiliar de agendamiento">
        <bpmn:flowNodeRef>Task_Leer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PedirDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultarEPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Activo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Autorizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuscarEspacio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Espacio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Paciente" name="Paciente">
        <bpmn:flowNodeRef>Start_Necesita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnviarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoAsignada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirConfirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Asignada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Necesita" name="Necesita una cita">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_EnviarSolicitud" name="Enviar solicitud (teléfono, WhatsApp o correo)">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Leer" name="Leer la solicitud">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Datos" name="¿Datos completos?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PedirDatos" name="Pedir datos faltantes al paciente">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnviarDatos" name="Enviar datos faltantes">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConsultarEPS" name="Consultar paciente en el portal de la EPS">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MostrarEstado" name="Mostrar estado de afiliación y autorización">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Activo" name="¿Paciente activo?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Autorizacion" name="¿Tiene autorización (si aplica)?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Informar" name="Informar que no se puede agendar">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecibirRechazo" name="Recibir aviso de rechazo">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_NoAsignada" name="Cita no asignada">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_BuscarEspacio" name="Buscar espacio libre en la agenda del médico">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Espacio" name="¿Hay espacio?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Registrar" name="Registrar la cita a mano en el sistema">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GuardarBD" name="Guardar cita en base de datos">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirmar" name="Confirmar la cita por el mismo canal">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecibirConfirmacion" name="Recibir confirmación de la cita">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Asignada" name="Cita asignada">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Necesita" targetRef="Task_EnviarSolicitud" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_EnviarSolicitud" targetRef="Task_Leer" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_EnviarDatos" targetRef="Task_Leer" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Leer" targetRef="GW_Datos" />
    <bpmn:sequenceFlow id="F04" name="No" sourceRef="GW_Datos" targetRef="Task_PedirDatos" />
    <bpmn:sequenceFlow id="F07" name="Sí" sourceRef="GW_Datos" targetRef="Task_ConsultarEPS" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_PedirDatos" targetRef="Task_EnviarDatos" />
    <bpmn:sequenceFlow id="F08" sourceRef="Task_ConsultarEPS" targetRef="Task_MostrarEstado" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_MostrarEstado" targetRef="GW_Activo" />
    <bpmn:sequenceFlow id="F10" name="Sí" sourceRef="GW_Activo" targetRef="GW_Autorizacion" />
    <bpmn:sequenceFlow id="F11" name="No" sourceRef="GW_Activo" targetRef="Task_Informar" />
    <bpmn:sequenceFlow id="F12" name="Sí" sourceRef="GW_Autorizacion" targetRef="Task_BuscarEspacio" />
    <bpmn:sequenceFlow id="F13" name="No" sourceRef="GW_Autorizacion" targetRef="Task_Informar" />
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="GW_Espacio" targetRef="Task_Informar" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Informar" targetRef="Task_RecibirRechazo" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_RecibirRechazo" targetRef="End_NoAsignada" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_BuscarEspacio" targetRef="GW_Espacio" />
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="GW_Espacio" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Registrar" targetRef="Task_GuardarBD" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_GuardarBD" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Confirmar" targetRef="Task_RecibirConfirmacion" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_RecibirConfirmacion" targetRef="End_Asignada" />
  </bpmn:process>
