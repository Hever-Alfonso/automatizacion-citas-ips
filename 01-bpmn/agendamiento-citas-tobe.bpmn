<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Participant_IPS" name="IPS – Asignación automatizada de citas (TO-BE)" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_RPA" name="Bot RPA">
        <bpmn:flowNodeRef>Task_VerificarEPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuscarEspacio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cancelar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IA" name="IA">
        <bpmn:flowNodeRef>Task_IA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orquestador" name="Orquestador (n8n)">
        <bpmn:flowNodeRef>GW_EPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Espacio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recordatorio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auxiliar" name="Auxiliar (excepciones)">
        <bpmn:flowNodeRef>Task_Excepcion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Paciente" name="Paciente">
        <bpmn:flowNodeRef>Start_Necesita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Excepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Responder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Necesita" name="Necesita una cita">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Solicitar" name="Solicitar cita (WhatsApp, correo o llamada)">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IA" name="Extraer datos de la solicitud">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerificarEPS" name="Verificar paciente en portal EPS">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_EPS" name="¿Activo y autorizado?">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BuscarEspacio" name="Buscar espacio en la agenda">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Espacio" name="¿Hay espacio?">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Excepcion" name="Atender excepción con el paciente">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Excepcion" name="Caso atendido por auxiliar">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Registrar" name="Registrar cita y guardar en base de datos">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirmar" name="Enviar confirmación">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Recordatorio" name="Enviar recordatorio 24 h antes">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Responder" name="Responder recordatorio">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Respuesta" name="¿Qué responde?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Confirmada" name="Cita confirmada">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Cancelar" name="Cancelar cita y liberar espacio">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cancelada" name="Cita cancelada">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Necesita" targetRef="Task_Solicitar" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Solicitar" targetRef="Task_IA" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_IA" targetRef="Task_VerificarEPS" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_VerificarEPS" targetRef="GW_EPS" />
    <bpmn:sequenceFlow id="F05" name="No" sourceRef="GW_EPS" targetRef="Task_Excepcion" />
    <bpmn:sequenceFlow id="F06" name="Sí" sourceRef="GW_EPS" targetRef="Task_BuscarEspacio" />
    <bpmn:sequenceFlow id="F17" name="Reprograma" sourceRef="GW_Respuesta" targetRef="Task_BuscarEspacio" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_BuscarEspacio" targetRef="GW_Espacio" />
    <bpmn:sequenceFlow id="F08" name="Sí" sourceRef="GW_Espacio" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F09" name="No" sourceRef="GW_Espacio" targetRef="Task_Excepcion" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Excepcion" targetRef="End_Excepcion" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Registrar" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Confirmar" targetRef="Task_Recordatorio" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Recordatorio" targetRef="Task_Responder" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Responder" targetRef="GW_Respuesta" />
    <bpmn:sequenceFlow id="F15" name="Confirma" sourceRef="GW_Respuesta" targetRef="End_Confirmada" />
    <bpmn:sequenceFlow id="F16" name="Cancela" sourceRef="GW_Respuesta" targetRef="Task_Cancelar" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Cancelar" targetRef="End_Cancelada" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ToBe">
    <bpmndi:BPMNPlane id="Plane_ToBe" bpmnElement="Collab_ToBe">
      <bpmndi:BPMNShape id="Participant_IPS_di" bpmnElement="Participant_IPS" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1700" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_RPA_di" bpmnElement="Lane_RPA" isHorizontal="true">
        <dc:Bounds x="180" y="640" width="1670" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IA_di" bpmnElement="Lane_IA" isHorizontal="true">
        <dc:Bounds x="180" y="500" width="1670" height="140" />
