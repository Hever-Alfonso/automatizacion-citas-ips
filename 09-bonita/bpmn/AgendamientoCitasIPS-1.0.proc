        <elements xmi:type="process:XORGateway" xmi:id="_GW_JoinConfirmar" name="Convergencia Confirmación" outgoing="_Flow_F_ToConfirmar" incoming="_Flow_F_Aux_Agendada _Flow_F11">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_GW_JoinConfirmar" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_GW_JoinConfirmar" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_GW_JoinConfirmar" name="" content="" returnTypeFixed="true"/>
        </elements>
        <elements xmi:type="process:ServiceTask" xmi:id="_Task_Confirmar" documentation="Conector REST / Correo que envía inmediatamente los datos de confirmación de la cita (fecha, hora, médico, sede y recomendaciones) por el canal del paciente." name="Enviar confirmación de cita" outgoing="_Flow_F12" incoming="_Flow_F_ToConfirmar">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_Task_Confirmar" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_Task_Confirmar" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_Task_Confirmar" name="" content="" returnTypeFixed="true"/>
          <operations xmi:type="expression:Operation" xmi:id="_Op_Confirmar_Cita">
            <leftOperand xmi:type="expression:Expression" xmi:id="_LO_Confirmar_Cita" name="citaMedica" content="citaMedica" type="TYPE_VARIABLE" returnType="co.edu.eafit.ips.model.CitaMedica">
