            <rightOperand xmi:type="expression:Expression" xmi:id="_RO_Task_IA" name="procesarExtraccionIA()" content="def pac = solicitudCita.paciente&#xD;&#xA;def msg = (solicitudCita.mensajeOriginal ?: &quot;&quot;).toUpperCase()&#xD;&#xA;&#xD;&#xA;if (msg.contains(&quot;ODONTOLOGIA&quot;) || msg.contains(&quot;ODONTOLOGÍA&quot;)) {&#xD;&#xA;    solicitudCita.especialidadRequerida = &quot;ODONTOLOGIA&quot;&#xD;&#xA;} else if (msg.contains(&quot;PEDIATRIA&quot;) || msg.contains(&quot;PEDIATRÍA&quot;)) {&#xD;&#xA;    solicitudCita.especialidadRequerida = &quot;PEDIATRIA&quot;&#xD;&#xA;} else if (!solicitudCita.especialidadRequerida) {&#xD;&#xA;    solicitudCita.especialidadRequerida = &quot;MEDICINA GENERAL&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;solicitudCita.nivelUrgencia = msg.contains(&quot;URGENTE&quot;) ? &quot;ALTA&quot; : &quot;MEDIA&quot;&#xD;&#xA;solicitudCita.jornadaPreferida = msg.contains(&quot;TARDE&quot;) ? &quot;TARDE&quot; : &quot;MANANA&quot;&#xD;&#xA;solicitudCita.confianzaIA = (solicitudCita.mensajeOriginal &amp;&amp; solicitudCita.mensajeOriginal.length() &gt;= 15) ? 0.94d : 0.65d&#xD;&#xA;&#xD;&#xA;boolean camposMinimos = (&#xD;&#xA;    pac.tipoDocumento &amp;&amp; pac.tipoDocumento != &quot;PENDIENTE&quot; &amp;&amp;&#xD;&#xA;    pac.numeroDocumento &amp;&amp; !pac.numeroDocumento.startsWith(&quot;TMP-&quot;) &amp;&amp;&#xD;&#xA;    pac.eps &amp;&amp; pac.eps != &quot;POR_EXTRAER&quot; &amp;&amp;&#xD;&#xA;    solicitudCita.especialidadRequerida&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;solicitudCita.datosCompletos = camposMinimos&#xD;&#xA;if (camposMinimos &amp;&amp; solicitudCita.confianzaIA &gt;= 0.80d) {&#xD;&#xA;    solicitudCita.estadoSolicitud = &quot;VALIDADA_IA&quot;&#xD;&#xA;    solicitudCita.requiereExcepcion = false&#xD;&#xA;    solicitudCita.motivoExcepcion = null&#xD;&#xA;} else {&#xD;&#xA;    solicitudCita.estadoSolicitud = &quot;EN_EXCEPCION&quot;&#xD;&#xA;    solicitudCita.requiereExcepcion = true&#xD;&#xA;    solicitudCita.motivoExcepcion = 