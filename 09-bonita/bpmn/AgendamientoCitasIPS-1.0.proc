        </elements>
        <elements xmi:type="process:XORGateway" xmi:id="_GW_EPS" name="¿Activo y autorizado?" outgoing="_Flow_F_EPS_Si _Flow_F_EPS_No" incoming="_Flow_F04">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_GW_EPS" name="" content="" returnTypeFixed="true"/>
