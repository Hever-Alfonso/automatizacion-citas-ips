<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:decision="http://www.bonitasoft.org/ns/bpm/process/decision" xmlns:expression="http://www.bonitasoft.org/ns/bpm/expression" xmlns:notation="http://www.eclipse.org/gmf/runtime/1.0.3/notation" xmlns:parameter="http://www.bonitasoft.org/ns/bpm/parameter" xmlns:process="http://www.bonitasoft.org/ns/bpm/process">
  <process:MainProcess xmi:id="_Main_AgendamientoCitasIPS" name="AgendamientoCitasIPS" version="1.0" bonitaModelVersion="9">
    <elements xmi:type="process:Pool" xmi:id="_Pool_AgendamientoCitasIPS" documentation="Proceso ejecutable BPMS en Bonita Studio para la automatización de asignación, confirmación, recordatorio, reprogramación y cancelación de citas médicas en una IPS de consulta externa (Cumplimiento Ley 1581 de 2012)." name="Agendamiento Automatizado de Citas IPS" version="1.0">
      <parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpHost" name="smtpHost" typeClassname="java.lang.String" description="Servidor SMTP (localhost para bandeja web local; smtp.gmail.com para Gmail)"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpPort" name="smtpPort" typeClassname="java.lang.Integer" description="Puerto SMTP (1025 bandeja web local, 465 SSL, 587 STARTTLS)"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpSsl" name="smtpSsl" typeClassname="java.lang.Boolean" description="Usar SSL/TLS directo (true para puerto 465)"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpStarttls" name="smtpStarttls" typeClassname="java.lang.Boolean" description="Usar STARTTLS (true para puerto 587)"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpUser" name="smtpUser" typeClassname="java.lang.String" description="Usuario SMTP. Use &apos;-&apos; si no requiere autenticacion"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpPassword" name="smtpPassword" typeClassname="java.lang.String" description="Clave o App Password SMTP. Use &apos;-&apos; si no requiere autenticacion"/><parameters xmi:type="parameter:Parameter" xmi:id="_PM_smtpFrom" name="smtpFrom" typeClassname="java.lang.String" description="Direccion remitente de las notificaciones"/>
      <elements xmi:type="process:Lane" xmi:id="_Lane_Paciente" name="Paciente (Portal / WhatsApp)" actor="_Actor_Paciente">
        <elements xmi:type="process:StartEvent" xmi:id="_Start_Solicitud" documentation="Inicio del proceso mediante formulario de solicitud en Portal Bonita o invocación vía REST API desde webhook omnicanal (WhatsApp/Correo). Valida consentimiento Ley 1581." name="Solicitud recibida" outgoing="_Flow_F01">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_Start_Solicitud" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_Start_Solicitud" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_Start_Solicitud" name="" content="" returnTypeFixed="true"/>
        </elements>
        <elements xmi:type="process:EndEvent" xmi:id="_End_Excepcion" documentation="Fin del caso cuando la excepción no permite asignar cita (ej. afiliación suspendida o paciente desiste)." name="Solicitud cerrada sin cita" incoming="_Flow_F_Aux_Cerrado">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_End_Excepcion" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_End_Excepcion" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_End_Excepcion" name="" content="" returnTypeFixed="true"/>
        </elements>
        <elements xmi:type="process:Task" xmi:id="_Task_Responder" documentation="Tarea de usuario (Portal Paciente o completada automáticamente vía Bonita REST API cuando el paciente responde en WhatsApp): CONFIRMAR, REPROGRAMAR o CANCELAR." name="Responder recordatorio" outgoing="_Flow_F14" incoming="_Flow_F13" overrideActorsOfTheLane="false" actor="_Actor_Paciente">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_Task_Responder" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_Task_Responder" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_Task_Responder" name="" content="" returnTypeFixed="true"/>
          <operations xmi:type="expression:Operation" xmi:id="_Op_Responder_Var">
            <leftOperand xmi:type="expression:Expression" xmi:id="_LO_Responder_Var" name="respuestaRecordatorio" content="respuestaRecordatorio" type="TYPE_VARIABLE" returnType="java.lang.String">
              <referencedElements xmi:type="process:Data" xmi:id="_Ref_Responder_Var" name="respuestaRecordatorio" dataType="_DT_Text"/>
            </leftOperand>
            <rightOperand xmi:type="expression:Expression" xmi:id="_RO_Responder_Var" name="scriptAccionPaciente" content="return (respuestaInput?.accionPaciente ?: &quot;CONFIRMAR&quot;).toUpperCase()" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.String">
              <referencedElements xmi:type="process:ContractInput" xmi:id="_Ref_CI_respuestaInput_1" name="respuestaInput" type="COMPLEX"/>
            </rightOperand>
            <operator xmi:type="expression:Operator" xmi:id="_Opr_Responder_Var" type="ASSIGNMENT"/>
          </operations>
          <operations xmi:type="expression:Operation" xmi:id="_Op_Responder_BDM">
            <leftOperand xmi:type="expression:Expression" xmi:id="_LO_Responder_BDM" name="citaMedica" content="citaMedica" type="TYPE_VARIABLE" returnType="co.edu.eafit.ips.model.CitaMedica">
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Responder_Cita" name="citaMedica" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.CitaMedica"/>
            </leftOperand>
            <rightOperand xmi:type="expression:Expression" xmi:id="_RO_Responder_BDM" name="actualizarRespuestaCita()" content="import java.time.OffsetDateTime&#xD;&#xA;import java.time.ZoneOffset&#xD;&#xA;&#xD;&#xA;def accion = (respuestaInput?.accionPaciente ?: &quot;CONFIRMAR&quot;).toUpperCase()&#xD;&#xA;if (citaMedica != null) {&#xD;&#xA;    citaMedica.respuestaRecordatorio = accion&#xD;&#xA;    citaMedica.fechaActualizacion = OffsetDateTime.now(ZoneOffset.ofHours(-5))&#xD;&#xA;    if (accion == &quot;CONFIRMAR&quot;) {&#xD;&#xA;        citaMedica.estado = &quot;CONFIRMADA&quot;&#xD;&#xA;        solicitudCita.estadoSolicitud = &quot;CONFIRMADA&quot;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;return citaMedica" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="co.edu.eafit.ips.model.CitaMedica">
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Responder_Cita2" name="citaMedica" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.CitaMedica"/>
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Responder_Sol" name="solicitudCita" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.SolicitudCita"/>
              <referencedElements xmi:type="process:ContractInput" xmi:id="_Ref_CI_respuestaInput_2" name="respuestaInput" type="COMPLEX"/>
            </rightOperand>
            <operator xmi:type="expression:Operator" xmi:id="_Opr_Responder_BDM" type="ASSIGNMENT"/>
          </operations>
          <loopCondition xmi:type="expression:Expression" xmi:id="_LC_Task_Responder" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/>
          <loopMaximum xmi:type="expression:Expression" xmi:id="_LM_Task_Responder" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
          <cardinalityExpression xmi:type="expression:Expression" xmi:id="_CE_Task_Responder" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
          <iteratorExpression xmi:type="expression:Expression" xmi:id="_IE_Task_Responder" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/>
          <completionCondition xmi:type="expression:Expression" xmi:id="_CC_Task_Responder" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/>
          <formMapping xmi:type="process:FormMapping" xmi:id="_FM_Task_Responder" type="NONE">
            <targetForm xmi:type="expression:Expression" xmi:id="_TF_Task_Responder" name="" content="" type="FORM_REFERENCE_TYPE" returnTypeFixed="true"/>
          </formMapping>
          <contract xmi:type="process:Contract" xmi:id="_Contract_Task_Responder">
            <inputs xmi:type="process:ContractInput" xmi:id="_CI_respuestaInput" name="respuestaInput" type="COMPLEX" description="Respuesta del paciente al recordatorio 24h antes">
              <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_respuestaInput"/>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_accionPaciente" name="accionPaciente" description="CONFIRMAR, REPROGRAMAR o CANCELAR">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_accionPaciente"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_motivoOpcional" name="motivoOpcional" description="Motivo opcional de reprogramación o cancelación">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_motivoOpcional"/>
              </inputs>
            </inputs>
            <constraints xmi:type="process:ContractConstraint" xmi:id="_CC_Regla_Accion_Valida" expression="[&apos;CONFIRMAR&apos;, &apos;REPROGRAMAR&apos;, &apos;CANCELAR&apos;].contains(respuestaInput.accionPaciente)" errorMessage="La respuesta al recordatorio debe ser CONFIRMAR, REPROGRAMAR o CANCELAR." name="Regla_Accion_Valida">
              <inputNames>respuestaInput</inputNames>
            </constraints>
          </contract>
          <expectedDuration xmi:type="expression:Expression" xmi:id="_ED_Task_Responder" name="" content="" returnType="java.lang.Long" returnTypeFixed="true"/>
        </elements>
      </elements>
      <elements xmi:type="process:Lane" xmi:id="_Lane_Auxiliar" name="Auxiliar de agendamiento (Excepciones)" actor="_Actor_Auxiliar">
        <elements xmi:type="process:XORGateway" xmi:id="_GW_JoinExcepcion" name="Convergencia Excepción" outgoing="_Flow_F_ToExcepcion" incoming="_Flow_F_Datos_No _Flow_F_EPS_No _Flow_F_Espacio_No">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_GW_JoinExcepcion" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_GW_JoinExcepcion" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_GW_JoinExcepcion" name="" content="" returnTypeFixed="true"/>
        </elements>
        <elements xmi:type="process:Task" xmi:id="_Task_Excepcion" documentation="Tarea Humana asignada al rol Auxiliar de Agendamiento en Bonita Portal. Permite completar datos faltantes, gestionar autorizaciones especiales o asignar cupo manual." name="Atender excepción con el paciente" outgoing="_Flow_F10" incoming="_Flow_F_ToExcepcion" overrideActorsOfTheLane="false" actor="_Actor_Auxiliar">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_Task_Excepcion" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_Task_Excepcion" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_Task_Excepcion" name="" content="" returnTypeFixed="true"/>
          <operations xmi:type="expression:Operation" xmi:id="_Op_Excepcion_Cita">
            <leftOperand xmi:type="expression:Expression" xmi:id="_LO_Excepcion_Cita" name="citaMedica" content="citaMedica" type="TYPE_VARIABLE" returnType="co.edu.eafit.ips.model.CitaMedica">
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Excepcion_Cita" name="citaMedica" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.CitaMedica"/>
            </leftOperand>
            <rightOperand xmi:type="expression:Expression" xmi:id="_RO_Excepcion_Cita" name="procesarResolucionAuxiliar()" content="import co.edu.eafit.ips.model.CitaMedica&#xD;&#xA;import java.time.OffsetDateTime&#xD;&#xA;import java.time.ZoneOffset&#xD;&#xA;&#xD;&#xA;def ahora = OffsetDateTime.now(ZoneOffset.ofHours(-5))&#xD;&#xA;solicitudCita.observacionesAuxiliar = resolucionAuxiliarInput?.observaciones&#xD;&#xA;&#xD;&#xA;if (resolucionAuxiliarInput?.numeroDocumentoCorregido) {&#xD;&#xA;    solicitudCita.paciente.numeroDocumento = resolucionAuxiliarInput.numeroDocumentoCorregido.trim()&#xD;&#xA;}&#xD;&#xA;if (resolucionAuxiliarInput?.codigoAutorizacionManual) {&#xD;&#xA;    solicitudCita.codigoAutorizacionEPS = resolucionAuxiliarInput.codigoAutorizacionManual.trim()&#xD;&#xA;    solicitudCita.autorizacionVigente = true&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (resolucionAuxiliarInput?.logroAgendar == true) {&#xD;&#xA;    solicitudCita.estadoSolicitud = &quot;AGENDADA&quot;&#xD;&#xA;    def citaManual = (citaMedica != null) ? citaMedica : new CitaMedica()&#xD;&#xA;    citaManual.codigoCita = &quot;CITA-MAN-${solicitudCita.codigoRadicado.replace(&apos;IPS-&apos;, &apos;&apos;)}&quot;&#xD;&#xA;    citaManual.fechaHoraCita = resolucionAuxiliarInput.fechaHoraAsignada ?: ahora.plusDays(2)&#xD;&#xA;    citaManual.especialidad = resolucionAuxiliarInput.especialidadAsignada ?: (solicitudCita.especialidadRequerida ?: &quot;MEDICINA GENERAL&quot;)&#xD;&#xA;    citaManual.nombreMedico = resolucionAuxiliarInput.medicoAsignado ?: &quot;Dr. Turno Central&quot;&#xD;&#xA;    citaManual.consultorio = resolucionAuxiliarInput.consultorioAsignado ?: &quot;101&quot;&#xD;&#xA;    citaManual.sedeIPS = resolucionAuxiliarInput.sedeAsignada ?: &quot;Sede Principal&quot;&#xD;&#xA;    citaManual.estado = &quot;AGENDADA&quot;&#xD;&#xA;    citaManual.asignadaPorAuxiliar = true&#xD;&#xA;    citaManual.confirmacionEnviada = false&#xD;&#xA;    citaManual.recordatorioEnviado = false&#xD;&#xA;    citaManual.fechaRegistro = ahora&#xD;&#xA;    citaManual.paciente = solicitudCita.paciente&#xD;&#xA;    citaManual.solicitudOrigen = solicitudCita&#xD;&#xA;    return citaManual&#xD;&#xA;} else {&#xD;&#xA;    solicitudCita.estadoSolicitud = &quot;RECHAZADA&quot;&#xD;&#xA;    return null&#xD;&#xA;}" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="co.edu.eafit.ips.model.CitaMedica">
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Excepcion_Sol" name="solicitudCita" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.SolicitudCita"/>
              <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_Ref_Excepcion_Cita2" name="citaMedica" dataType="_DT_Business_Object" className="co.edu.eafit.ips.model.CitaMedica"/>
              <referencedElements xmi:type="process:ContractInput" xmi:id="_Ref_CI_resolucionAuxiliarInput" name="resolucionAuxiliarInput" type="COMPLEX"/>
            </rightOperand>
            <operator xmi:type="expression:Operator" xmi:id="_Opr_Excepcion_Cita" type="ASSIGNMENT"/>
          </operations>
          <loopCondition xmi:type="expression:Expression" xmi:id="_LC_Task_Excepcion" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/>
          <loopMaximum xmi:type="expression:Expression" xmi:id="_LM_Task_Excepcion" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
          <cardinalityExpression xmi:type="expression:Expression" xmi:id="_CE_Task_Excepcion" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
          <iteratorExpression xmi:type="expression:Expression" xmi:id="_IE_Task_Excepcion" name="multiInstanceIterator" content="multiInstanceIterator" type="MULTIINSTANCE_ITERATOR_TYPE" returnType="java.lang.Object" returnTypeFixed="true"/>
          <completionCondition xmi:type="expression:Expression" xmi:id="_CC_Task_Excepcion" name="" content="" returnType="java.lang.Boolean" returnTypeFixed="true"/>
          <formMapping xmi:type="process:FormMapping" xmi:id="_FM_Task_Excepcion" type="NONE">
            <targetForm xmi:type="expression:Expression" xmi:id="_TF_Task_Excepcion" name="" content="" type="FORM_REFERENCE_TYPE" returnTypeFixed="true"/>
          </formMapping>
          <contract xmi:type="process:Contract" xmi:id="_Contract_Task_Excepcion">
            <inputs xmi:type="process:ContractInput" xmi:id="_CI_resolucionAuxiliarInput" name="resolucionAuxiliarInput" type="COMPLEX" description="Datos de resolución manual por el Auxiliar de Agendamiento">
              <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_resolucionAuxiliarInput"/>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_logroAgendar" name="logroAgendar" type="BOOLEAN">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_logroAgendar"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_numeroDocumentoCorregido" name="numeroDocumentoCorregido">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_numeroDocumentoCorregido"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_codigoAutorizacionManual" name="codigoAutorizacionManual">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_codigoAutorizacionManual"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_especialidadAsignada" name="especialidadAsignada">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_especialidadAsignada"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_medicoAsignado" name="medicoAsignado">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_medicoAsignado"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_sedeAsignada" name="sedeAsignada">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_sedeAsignada"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_consultorioAsignado" name="consultorioAsignado">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_consultorioAsignado"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_fechaHoraAsignada" name="fechaHoraAsignada" type="OFFSETDATETIME">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_fechaHoraAsignada"/>
              </inputs>
              <inputs xmi:type="process:ContractInput" xmi:id="_CI_observaciones" name="observaciones">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_CIM_observaciones"/>
              </inputs>
            </inputs>
            <constraints xmi:type="process:ContractConstraint" xmi:id="_CC_Regla_Cita_Manual" expression="!resolucionAuxiliarInput.logroAgendar || (resolucionAuxiliarInput.especialidadAsignada != null &amp;&amp; resolucionAuxiliarInput.medicoAsignado != null &amp;&amp; resolucionAuxiliarInput.fechaHoraAsignada != null)" errorMessage="Si marca que logró agendar la cita manualmente, debe indicar especialidad, médico y fecha/hora asignada." name="Regla_Datos_Cita_Manual_Obligatorios">
              <inputNames>resolucionAuxiliarInput</inputNames>
            </constraints>
          </contract>
          <expectedDuration xmi:type="expression:Expression" xmi:id="_ED_Task_Excepcion" name="" content="" returnType="java.lang.Long" returnTypeFixed="true"/>
        </elements>
        <elements xmi:type="process:XORGateway" xmi:id="_GW_ResolucionAuxiliar" name="¿Agendada?" outgoing="_Flow_F_Aux_Cerrado _Flow_F_Aux_Agendada" incoming="_Flow_F10">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_DL_GW_ResolucionAuxiliar" name="" content="" returnTypeFixed="true"/>
          <dynamicDescription xmi:type="expression:Expression" xmi:id="_DD_GW_ResolucionAuxiliar" name="" content="" returnTypeFixed="true"/>
          <stepSummary xmi:type="expression:Expression" xmi:id="_SS_GW_ResolucionAuxiliar" name="" content="" returnTypeFixed="true"/>
        </elements>
