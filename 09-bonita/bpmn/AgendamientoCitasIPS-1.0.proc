ud - Central de Citas&lt;/b&gt;&lt;/p&gt;&#xD;&#xA;&lt;/body&gt;&lt;/html&gt;&quot;&quot;&quot;&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;    String host = (binding.hasVariable(&apos;smtpHost&apos;) &amp;&amp; smtpHost) ? smtpHost : &apos;localhost&apos;&#xD;&#xA;    int port = (binding.hasVariable(&apos;smtpPort&apos;) &amp;&amp; smtpPort != null) ? (smtpPort as int) : 1025&#xD;&#xA;    String fromAddr = (binding.hasVariable(&apos;smtpFrom&apos;) &amp;&amp; smtpFrom) ? smtpFrom : &apos;citas@ips-salud.co&apos;&#xD;&#xA;    String toAddr = solicitudCita?.paciente?.correoElectronico ?: &apos;paciente@ips-salud.co&apos;&#xD;&#xA;    boolean useSsl = (binding.hasVariable(&apos;smtpSsl&apos;) &amp;&amp; smtpSsl == true)&#xD;&#xA;    Socket sock = useSsl&#xD;&#xA;        ? javax.net.ssl.SSLSocketFactory.default.createSocket(host, port)&#xD;&#xA;        : new Socket()&#xD;&#xA;    if (!useSsl) {&#xD;&#xA;        sock.connect(new java.net.InetSocketAddress(host, port), 4000)&#xD;&#xA;    }&#xD;&#xA;    sock.soTimeout = 4000&#xD;&#xA;    def reader = new BufferedReader(new InputStreamReader(sock.inputStream, &apos;UTF-8&apos;))&#xD;&#xA;    def writer = new OutputStreamWriter(sock.outputStream, &apos;UTF-8&apos;)&#xD;&#xA;    def sendCmd = { String cmd -&gt;&#xD;&#xA;        writer.write(cmd + &quot;\r\n&quot;)&#xD;&#xA;        writer.flush()&#xD;&#xA;        return reader.readLine()&#xD;&#xA;    }&#xD;&#xA;    reader.readLine()&#xD;&#xA;    sendCmd(&quot;EHLO ips-salud.co&quot;)&#xD;&#xA;    while (reader.ready()) { reader.readLine() }&#xD;&#xA;    if (binding.hasVariable(&apos;smtpUser&apos;) &amp;&amp; smtpUser &amp;&amp; smtpUser != &apos;-&apos;) {&#xD;&#xA;        String token = (&quot;\0&quot; + smtpUser + &quot;\0&quot; + (smtpPassword ?: &apos;&apos;)).bytes.encodeBase64().toString()&#xD;&#xA;        sendCmd(&quot;AUTH PLAIN &quot; + token)&#xD;&#xA;    }&#xD;&#xA;    sendCmd(&quot;MAIL FROM:&lt;&quot; + fromAddr + &quot;&gt;&quot;)&#xD;&#xA;    sendCmd(&quot;RCPT TO:&lt;&